import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int q=sc.nextInt();
        Stack<Integer> s1=new Stack<>();
        Stack<Integer> s2=new Stack<>();
        while(q-->0){
            String op=sc.next();
            if(op.equals("ENQUEUE")){
                s1.push(sc.nextInt());
            }
            else if(op.equals("DEQUEUE")||op.equals("FRONT")){
                if(s2.isEmpty()){
                    while(!s1.isEmpty())s2.push(s1.pop());
                }
                if(s2.isEmpty())System.out.println("EMPTY");
                else if(op.equals("DEQUEUE"))System.out.println(s2.pop());
                else System.out.println(s2.peek());
            }
        }
    }
}
