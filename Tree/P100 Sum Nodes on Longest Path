class Solution {
    int maxLen=0;
    int maxSum=0;

    public int sumOfLongRootToLeafPath(TreeNode root) {
        solve(root,0,0);
        return maxSum;
    }

    public void solve(TreeNode root,int len,int sum) {
        if(root==null)return;
        len++;
        sum+=root.val;
        if(root.left==null&&root.right==null){
            if(len>maxLen){
                maxLen=len;
                maxSum=sum;
            }
            else if(len==maxLen){
                maxSum=Math.max(maxSum,sum);
            }
        }
        solve(root.left,len,sum);
        solve(root.right,len,sum);
    }
}
