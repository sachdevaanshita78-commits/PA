class Solution {
    public void preorder(TreeNode root) {
        if(root==null)return;
        Stack<TreeNode> st=new Stack<>();
        st.push(root);
        while(!st.isEmpty()){
            TreeNode node=st.pop();
            System.out.print(node.val+" ");
            if(node.right!=null)st.push(node.right);
            if(node.left!=null)st.push(node.left);
        }
    }
}
