class Solution {
    public void inorder(TreeNode root) {
        Stack<TreeNode> st=new Stack<>();
        TreeNode curr=root;
        while(curr!=null||!st.isEmpty()){
            while(curr!=null){
                st.push(curr);
                curr=curr.left;
            }
            curr=st.pop();
            System.out.print(curr.val+" ");
            curr=curr.right;
        }
    }
}
