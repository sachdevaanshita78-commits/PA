class Solution {
    public int timeRequiredToBuy(int[] tickets, int k) {
        Queue<Integer> q = new LinkedList<>();

        for (int i = 0; i < tickets.length; i++) {
            q.add(tickets[i]);
        }

        int pos = k;
        int count = tickets[k];
        int time = 0;

        while (count != 0) {
            int val = q.poll();

            val--;
            time++;

            // This was person k
            if (pos == 0) {
                count--;

                // Person k still needs tickets
                if (val != 0) {
                    q.add(val);
                    pos = q.size() - 1;
                }
            } 
            else {
                // Some other person
                if (val != 0) {
                    q.add(val);
                }

                pos--;
            }
        }

        return time;
    }
}
